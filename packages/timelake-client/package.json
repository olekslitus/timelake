{
  "name": "@timelake/client",
  "version": "0.0.1",
  "description": "Read Timelake tables over HTTPS from the browser, Node, or serverless functions (WASM reader, Zod-typed rows)",
  "license": "Apache-2.0",
  "homepage": "https://timelake.dev/docs/typescript",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/olekslitus/timelake.git",
    "directory": "packages/timelake-client"
  },
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build:wasm": "bash scripts/build-wasm.sh",
    "build": "tsc -p tsconfig.json && cp src/wasm/*.js src/wasm/*.d.ts dist/wasm/",
    "test": "bun test",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "peerDependencies": {
    "zod": "^4"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^5",
    "wasm-opt": "^1.4.0",
    "zod": "^4"
  },
  "trustedDependencies": [
    "wasm-opt"
  ]
}
